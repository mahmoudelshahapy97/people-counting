# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="People Counting API"
APP_DESCRIPTION="Per-camera head counts, occupancy alerts and footfall analytics"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8083","http://localhost:8004"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID","X-Workspace-Id"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=pc_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@insighteye.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# "Forgot your password?" mails a 6-digit code to the account's email. It is
# off (the link is hidden) until SMTP_HOST is set below.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL (SMTP) -- password-reset codes and, with ALERT_EMAIL_ENABLED, alerts
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="People Counting <no-reply@insighteye.local>"
# STARTTLS on 587; set SMTP_SSL=true (and SMTP_STARTTLS=false) for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/peoplecount.log"

# =============================================================================
# DATABASE (POSTGRES)
# =============================================================================
POSTGRES_DB="peoplecount_db"
POSTGRES_USER="peoplecount"
POSTGRES_PASSWORD="peoplecount_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_DEVICE=cuda

# InsightEye's people detector (single class, 0 = person).
PEOPLE_MODEL_PATH="models/people.pt"
PEOPLE_CONFIDENCE=0.5
PEOPLE_INPUT_SIZE=640
PERSON_CLASS_ID=0
# FP16 on CUDA.
PEOPLE_HALF=true

# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames
FRAME_SKIP=5
# The live count and the MJPEG view update this often
TARGET_PROCESS_FPS=2.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# Concurrent MJPEG live viewers across all cameras
MAX_MJPEG_CLIENTS=4

# =============================================================================
# WORKER SUPERVISION
# =============================================================================
# Restart dead, errored or stalled workers; start enabled cameras with no worker
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15.0
WORKER_RESTART_BACKOFF_BASE_S=5.0
WORKER_RESTART_BACKOFF_MAX_S=300.0

# =============================================================================
# COUNTING
# =============================================================================
# One stored sample per camera this often; each is checked against the
# camera's limits (count_threshold_greater / count_threshold_less).
SAMPLE_INTERVAL_S=10.0
# At most one alert per camera per this window (InsightEye: 10 minutes).
ALERT_COOLDOWN_SECONDS=600
# Mail each alert to the workspace's operators and admins. Needs SMTP_HOST.
ALERT_EMAIL_ENABLED=false

# =============================================================================
# RETENTION
# =============================================================================
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
SAMPLE_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=90

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
# Alert snapshots go to MinIO; Postgres keeps the records and object keys.
# docker-compose sets these for the api from the root .env. Leave the endpoint
# empty to keep snapshots in Postgres.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=peoplecount
MINIO_SECURE=false
