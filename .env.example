# Root .env for docker-compose.yml. Copy to .env and set the MinIO password.

# Host ports for this stack (defaults shown; they sit next to lost-found's).
WEB_HOST_PORT=8083
API_HOST_PORT=8004
POSTGRES_HOST_PORT=5437
RTSP_HOST_PORT=8557
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

# MinIO (object storage for alert snapshots). The console logs in with these.
MINIO_ROOT_USER=peoplecount
MINIO_ROOT_PASSWORD=change-me-to-something-long
MINIO_BUCKET=peoplecount
